---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseRoster, parseSession, initials } from '../../lib/citadel.mjs';

const rosterFiles = import.meta.glob('../../data/citadel/ROSTER.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const sessionFiles = import.meta.glob('../../data/citadel/sessions/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const rosterRaw = Object.values(rosterFiles)[0] ?? '';
const { entries, ledger } = parseRoster(rosterRaw);

const sessions = Object.entries(sessionFiles)
  .map(([p, raw]) => parseSession(raw, path.basename(p, '.md')))
  .sort((a, b) => a.file.localeCompare(b.file));

// Which Bens actually have portraits on disk (new inductees may not yet).
let portraits = new Set();
try {
  portraits = new Set(
    fs
      .readdirSync(path.resolve('public/citadel/bens'))
      .filter((f) => f.endsWith('.png'))
      .map((f) => f.replace(/\.png$/, ''))
  );
} catch {}
---

<BaseLayout
  title="The Council of Bens"
  description="A multiverse council of alternate Ben Atkinses convenes to rule on questions of grave domestic importance."
  orbColor="rgba(34, 211, 238, 0.14)"
>
  <header class="mb-10">
    <h1
      class="text-4xl font-bold mb-3"
      style="font-family: var(--font-display); color: var(--color-heading);"
    >
      The Council of Bens
    </h1>
    <p class="leading-relaxed" style="color: var(--color-body);">
      Across infinite timelines there are infinite Bens, and when a question of grave
      domestic importance arises, they convene. Each session ends with a formal vote and a
      truth payload. The transcripts below are real, in the sense that anything here is real.
    </p>
    <p class="text-sm mt-2" style="color: var(--color-muted);">
      Formerly the Citadel of Bens. Original characters drawn in loving style-homage.
      Cowboy Ben leaves early. Nobody is surprised.
    </p>
  </header>

  <!-- Sessions -->
  <section class="mb-12">
    <h2 class="text-xs font-medium uppercase tracking-widest mb-4" style="color: var(--color-muted);">
      Sessions
    </h2>
    <div class="flex flex-col gap-4">
      {sessions.map((s) => (
        <a href={`/council/${s.file}/`} class="session-card group">
          <span class="session-badge">{s.number.padStart(3, '0')}</span>
          <span class="flex-1 min-w-0">
            <span class="flex flex-wrap items-baseline gap-2 mb-1">
              <span
                class="text-lg font-semibold group-hover:text-[#22d3ee] transition-colors duration-200"
                style="font-family: var(--font-display); color: var(--color-heading);"
              >
                {s.topic}
              </span>
              <span class="text-xs" style="color: var(--color-muted);">{s.date}</span>
            </span>
            <span class="block text-sm italic leading-relaxed" style="color: var(--color-body);">
              Motion: “{s.motion}”
            </span>
          </span>
          <span
            class="session-arrow group-hover:translate-x-1 group-hover:text-[#22d3ee] transition-all duration-200"
            style="color: var(--color-muted);"
          >→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Roster -->
  <section class="mb-12">
    <h2 class="text-xs font-medium uppercase tracking-widest mb-4" style="color: var(--color-muted);">
      The Roster
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {entries.map((ben) => (
        <div class="ben-card">
          {portraits.has(ben.slug) ? (
            <img
              class="ben-face"
              src={`/citadel/bens/${ben.slug}.png`}
              alt={`${ben.name} — cartoon portrait`}
              loading="lazy"
              width="112"
              height="112"
            />
          ) : (
            <span class="ben-face ben-face-missing" aria-hidden="true">{initials(ben.name)}</span>
          )}
          <div class="min-w-0">
            <h3
              class="text-base font-semibold mb-1"
              style="font-family: var(--font-display); color: var(--color-heading);"
            >
              {ben.name}
            </h3>
            <p class="text-sm leading-relaxed ben-bio" set:html={ben.html} />
            {ben.debut && (
              <p class="text-xs mt-2" style="color: var(--color-muted);">{ben.debut}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Character development ledger -->
  {ledger.length > 0 && (
    <section class="mb-6 border border-[#2a2a2a] rounded-lg p-6 bg-[#1a1a1a]">
      <h2 class="text-xs font-medium uppercase tracking-widest mb-4" style="color: var(--color-muted);">
        Character Development Ledger
      </h2>
      <ul class="flex flex-col gap-2">
        {ledger.map((item) => (
          <li class="text-sm leading-relaxed ledger-item" set:html={item} />
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .session-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border: 1px solid #2a2a2a;
    border-radius: 0.75rem;
    padding: 1.25rem;
    background: #1a1a1a;
    text-decoration: none;
    transition: border-color 0.25s, transform 0.2s ease, box-shadow 0.25s;
  }
  .session-card:hover {
    border-color: #22d3ee;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(34, 211, 238, 0.12);
  }
  .session-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    height: 2rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #0e7490, #164e63);
    color: #e0fbff;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .session-arrow {
    flex-shrink: 0;
    font-size: 1.1rem;
    margin-top: 0.2rem;
  }

  .ben-card {
    display: flex;
    gap: 1rem;
    border: 1px solid #2a2a2a;
    border-radius: 0.75rem;
    padding: 1.1rem;
    background: #1a1a1a;
  }
  .ben-face {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.6rem;
    border: 1px solid #2a2a2a;
    background: #262626;
    object-fit: cover;
    flex-shrink: 0;
  }
  .ben-face-missing {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .ben-bio {
    color: var(--color-body);
  }
  .ben-bio :global(strong) {
    color: var(--color-heading);
  }
  .ledger-item {
    color: var(--color-body);
  }
  .ledger-item :global(strong) {
    color: var(--color-heading);
  }
</style>
